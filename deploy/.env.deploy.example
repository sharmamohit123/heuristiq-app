# Copy to deploy/.env.deploy (gitignored) and fill in. Read by deploy/deploy.sh.

# Google Cloud
PROJECT_ID=your-gcp-project-id
REGION=asia-southeast1
SERVICE=heuristiq

# Supabase (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini on Vertex AI. Leave GOOGLE_VERTEX_API_KEY empty to authenticate with
# the Cloud Run service account (recommended).
GEMINI_MODEL=gemini-3-flash-preview
GOOGLE_CLOUD_LOCATION=global
GOOGLE_VERTEX_API_KEY=

# Optional: completion emails via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional: custom domain; defaults to the Cloud Run URL
APP_URL=

# Capacity. Keep MIN_INSTANCES=1 while judges are evaluating to avoid cold starts.
MIN_INSTANCES=1
MAX_INSTANCES=3
MAX_BROWSER_CONTEXTS=12
