# Copy to .env.local for local development.

# Supabase (Postgres, Auth, Storage)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Gemini credentials: set ONE of the following.
# 1. Vertex AI with Application Default Credentials (`gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# 2. Vertex AI Express mode API key
GOOGLE_VERTEX_API_KEY=
# 3. AI Studio API key
GOOGLE_GEMINI_API_KEY=

# Models (both default to gemini-3-flash-preview)
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_VISION_MODEL=gemini-3-flash-preview

# Max concurrent Chromium contexts per server instance (default 15)
# MAX_BROWSER_CONTEXTS=15

# Optional: experiment-completed emails via Resend
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Heuristiq <noreply@yourdomain.com>

# Public URL used in emails (defaults to the Cloud Run URL when deployed)
# APP_URL=http://localhost:3000

# Protects /api/cron/cleanup-recordings
# CRON_SECRET=
